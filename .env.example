# Copy to .env. Never commit .env.
# Every EXPO_PUBLIC_* value is compiled into the app bundle, so no secret goes
# here. Partner keys live only in the BFF (bff/.env.example, Vercel env).

# prod | staging | local (selects app version + tracking host)
EXPO_PUBLIC_STAGE=

# The cards.xtra BFF. Prototype: https://cards-xtra-bff.vercel.app
# Local dev: http://127.0.0.1:8787 (npm run dev in bff/).
EXPO_PUBLIC_API_BASE_URL=

# Production click-out host (confirm with CashKaro). Empty =
# uses BankKaro's network_url instead of a CashKaro-attributed link.
EXPO_PUBLIC_CK_TRACKING_HOST=

# Optional override for x-chkr-app-version (default: 4.6 staging, 4.9 prod)
EXPO_PUBLIC_CK_APP_VERSION=
