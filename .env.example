# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are inlined into the JS bundle: this keeps them out of
# git, it does not make them secret on the device.

# staging | prod | local  (default: staging)
EXPO_PUBLIC_STAGE=staging

# ── Secrets (all stages) ────────────────────────────────────
EXPO_PUBLIC_CK_API_KEY=
EXPO_PUBLIC_CK_BASIC_USER=
EXPO_PUBLIC_CK_BASIC_PASS=
EXPO_PUBLIC_BK_PARTNER_KEY=

# ── Hosts (only read for prod / local; staging hosts are built in) ──
# e.g. https://<ck-api-host>/v1
EXPO_PUBLIC_CK_BASE_URL=
# e.g. cktracking.cashkaro.com (confirm with CashKaro before cutover)
EXPO_PUBLIC_CK_TRACKING_HOST=
# e.g. https://platform.bankkaro.com/partner
EXPO_PUBLIC_BK_BASE_URL=

# ── CK Mini Apps API (ckminapps.com) ──
EXPO_PUBLIC_MINI_BASE_URL=https://ckminapps.com/v1
EXPO_PUBLIC_MINI_API_KEY=
EXPO_PUBLIC_MINI_BASIC_USER=
EXPO_PUBLIC_MINI_BASIC_PASS=

# Optional override for x-chkr-app-version (default: 4.6 staging, 4.9 prod/ckminapps)
EXPO_PUBLIC_CK_APP_VERSION=
