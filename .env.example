# Copy to .env and fill in (ask the CashKaro / BankKaro teams). Never commit .env.
# Every EXPO_PUBLIC_* value is compiled into the app bundle (see docs/auth-and-secrets.md):
# keeping them out of git does not make them secret on the device.

# prod = ckminapps.com (CK Mini Apps) + BankKaro partner prod
# staging = CK staging (its host no longer resolves) | local = your own backend
EXPO_PUBLIC_STAGE=prod

# ── Secrets (all stages) ────────────────────────────────────
EXPO_PUBLIC_CK_API_KEY=
EXPO_PUBLIC_CK_BASIC_USER=
EXPO_PUBLIC_CK_BASIC_PASS=
EXPO_PUBLIC_BK_PARTNER_KEY=

# ── Optional host overrides (prod / local; staging hosts are built in) ──
# Default for prod: https://ckminapps.com/v1
EXPO_PUBLIC_CK_BASE_URL=
# Production click-out host (confirm with CashKaro). Empty = card "Apply"
# uses BankKaro's network_url instead of a CashKaro-attributed link.
EXPO_PUBLIC_CK_TRACKING_HOST=
# Default: https://platform.bankkaro.com/partner
EXPO_PUBLIC_BK_BASE_URL=

# Optional override for x-chkr-app-version (default: 4.6 staging, 4.9 prod)
EXPO_PUBLIC_CK_APP_VERSION=
