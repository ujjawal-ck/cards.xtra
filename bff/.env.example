# Server-only values. Set them in Vercel project settings (sensitive), or in
# .env.local for `npm run dev`. Never put them in the app's .env.

# CashKaro mini apps API
CK_BASE_URL=https://ckminapps.com/v1
CK_API_KEY=
# ckminapps.com accepts only this app version on /token
CK_APP_VERSION=4.9
# Optional: only where CashKaro issued Basic auth (staging)
CK_BASIC_USER=
CK_BASIC_PASS=

# BankKaro partner API. Use the UAT host until a production key exists.
BK_BASE_URL=https://uat-platform.bankkaro.com/partner
BK_PARTNER_KEY=

# Withdraw, missing-cashback writes and ticket upload are OFF unless this is 1.
# Leave it unset for any build that goes to other people.
ALLOW_MONEY_ROUTES=

# Optional: one password for every new account (signupV1). Empty = the app sends a random one.
SIGNUP_PASSWORD=
