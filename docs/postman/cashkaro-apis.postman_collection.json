{
 "info": {
  "name": "cashkaro-apis",
  "description": "CashKaro staging APIs as called by the Cards.xtra app (src/api/cashkaro.ts, payments.ts, missingCashback.ts). Folder D creates real claims/OTPs: run on a TEST account only.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "A. Public (no login)",
   "item": [
    {
     "name": "token (aws bootstrap)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/vnd.api+json"
       },
       {
        "key": "x-api-key",
        "value": "{{CK_API_KEY}}"
       },
       {
        "key": "x-chkr-app-version",
        "value": "4.6"
       },
       {
        "key": "Content-Type",
        "value": "application/vnd.api+json"
       }
      ],
      "url": "{{CK_BASE}}/token",
      "auth": {
       "type": "basic",
       "basic": [
        {
         "key": "username",
         "value": "{{CK_BASIC_USER}}"
        },
        {
         "key": "password",
         "value": "{{CK_BASIC_PASS}}"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('token: status ' + pm.response.code, () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
         "let j = {}; try { j = pm.response.json(); } catch (e) {}",
         "if (pm.response.code >= 300) console.log('token ERROR BODY:', pm.response.text().slice(0, 300));",
         "const t = j && j.data && j.data.attributes && j.data.attributes.token;",
         "pm.test('token: present', () => pm.expect(t).to.be.a('string'));",
         "if (t) pm.environment.set('AWS_TOKEN', t);"
        ]
       }
      }
     ]
    },
