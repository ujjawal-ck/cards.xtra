{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      // iOS TestFlight submission. Leave these out to let `eas submit` prompt
      // interactively, or fill them in for non-interactive/CI runs:
      // "ios": {
      //   "appleId": "<apple-id-email-with-app-manager-role>",
      //   "ascAppId": "<App-Store-Connect-app-id>",
      //   "appleTeamId": "<CashKaro-apple-team-id>"
      // }
    }
  }
}
